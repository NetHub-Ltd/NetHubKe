# NetHubKe backend — example environment (safe placeholders only).
# Copy to .env / inject via your secret store. Never commit real values.

APP_NAME=NetHubKe
APP_VERSION=0.1.0
IMAGE_TAG=dev
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000

# Discrete DB credentials (URLs are assembled in app.core.config)
FASTAPI_DB_USER=nethub_app
FASTAPI_DB_PASSWORD=change-me
FASTAPI_DB_HOST=127.0.0.1
FASTAPI_DB_PORT=5432
FASTAPI_DB_NAME=nethub

# OIDC resource-server (IdP-agnostic)
OIDC_ISSUER=https://auth.example.com
OIDC_JWKS_URL=https://auth.example.com/oauth/v2/keys
# Bootstrap only: seed trusted_clients when the table is empty (comma-separated client ids)
AUDIENCE=
JWT_LEEWAY_SECONDS=60

# Ops / hardening
DIAGNOSTICS_ENABLED=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_USER_ROUTES=60/minute

# Optional Redis (trusted-client cache). Omit to disable caching.
REDIS_URL=

# Comma-separated emails promoted to admin on user sync (not public)
BOOTSTRAP_ADMIN_EMAILS=
