# NetHubKe API — copy to .env or .env.local (never commit real secrets)
# Pydantic settings load .env / .env.local from the backend working directory.

# --- App ---
APP_NAME=NetHubKe
APP_VERSION=0.1.0
IMAGE_TAG=local
STARTUP_TEST=false
ENVIRONMENT=development

# --- PostgreSQL (required) ---
FASTAPI_DB_USER=nethub
FASTAPI_DB_PASSWORD=change-me
FASTAPI_DB_NAME=nethub_dev
FASTAPI_DB_HOST=localhost
FASTAPI_DB_PORT=5432

# --- Upstream OIDC provider ---
# NetHubKe uses standard OIDC discovery; configure only the issuer and API audience.
# Authorization, token, JWKS, UserInfo and logout endpoints are read from discovery.
OIDC_ISSUER=https://identity.example.com
AUDIENCE=nethub-api
JWKS_CACHE_TTL=300
# Optional provider-specific role claim path; standard default is "roles".
OIDC_ROLE_CLAIM_PATH=roles
# Algorithms default to RS256 in code.
# ALGORITHMS=["RS256"]

# CORS — comma-separated origins (no wildcard)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Redis (optional cache) ---
REDIS_URL=redis://localhost:6379/0
JWKS_REDIS_TTL_SEC=120

# --- Shared product-token issuer (all registered products use this integration) ---
# Global rollout gate; keep false until acceptance and staging gates pass.
PRODUCT_TOKEN_EXCHANGE_ENABLED=false
PRODUCT_TOKEN_PRIVATE_KEY=
PRODUCT_TOKEN_ALLOW_ENV_PEM=false
PRODUCT_TOKEN_ISSUER=http://localhost:8000
PRODUCT_TOKEN_TTL_SEC=240
SIGNING_KEY_ENCRYPTION_KEY=
SIGNING_KEY_MAX_AGE_HOURS=168
SIGNING_KEY_RETIRE_OVERLAP_HOURS=24
