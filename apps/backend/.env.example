APP_NAME=NetHubKe
APP_VERSION=0.1.0
IMAGE_TAG=dev
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000

FASTAPI_DB_USER=nethub
FASTAPI_DB_PASSWORD=nethub
FASTAPI_DB_HOST=localhost
FASTAPI_DB_PORT=5432
FASTAPI_DB_NAME=nethub

OIDC_ISSUER=https://auth.example.com
OIDC_JWKS_URL=https://auth.example.com/oauth/v2/keys
AUDIENCE=nethub-api

# Comma-separated audiences (Zitadel client IDs, etc.)
# AUDIENCE=393540732444541094,393540262682427558
# JWT_LEEWAY_SECONDS=60
# OIDC_JWKS_URL=https://auth.example.com/oauth/v2/keys
# DIAGNOSTICS_ENABLED=false
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_USER_ROUTES=60/minute

# REDIS_URL=redis://redis-shared:6379/0
# BOOTSTRAP_ADMIN_EMAILS=you@nethub.co.ke
# AUDIENCE=  # bootstrap trusted clients when DB empty (comma-separated client ids)
