# NetHubKe API — copy to .env or .env.local (never commit real secrets)
# Pydantic settings load .env / .env.local from the backend working directory.

# --- App ---
APP_NAME=NetHubKe
APP_VERSION=0.1.0
IMAGE_TAG=local
STARTUP_TEST=false
ENVIRONMENT=development

# --- Postgres (required) ---
FASTAPI_DB_USER=nethub
FASTAPI_DB_PASSWORD=change-me
FASTAPI_DB_NAME=nethub_dev
FASTAPI_DB_HOST=localhost
FASTAPI_DB_PORT=5432

# --- Keycloak (IdP) — resource-server validation of access tokens ---
# Issuer must match token "iss". JWKS is typically:
#   {KEYCLOAK_ISSUER_URL}/protocol/openid-connect/certs
KEYCLOAK_ISSUER_URL=https://idp.example.com/realms/nethub
KEYCLOAK_JWKS=https://idp.example.com/realms/nethub/protocol/openid-connect/certs

# Audience expected in Keycloak access tokens for this API
AUDIENCE=nethub-backend
# Algorithms as JSON list string if needed; default RS256 in code
# ALGORITHMS=["RS256"]
JWKS_CACHE_TTL=3600

# CORS — comma-separated origins (no *)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Tawala / product hard-session exchange (N1; default OFF) ---
# Enable only after private key + issuer are set. Products verify via JWKS.
TAWALA_EXCHANGE_ENABLED=false
# PKCS#8 PEM; use \n for single-line env, or multiline in secret stores
TAWALA_JWT_PRIVATE_KEY=
# Leave empty in production. Keys are generated in Postgres and auto-rotated.
TAWALA_JWT_ALLOW_ENV_PEM=false
SIGNING_KEY_MAX_AGE_HOURS=168
SIGNING_KEY_RETIRE_OVERLAP_HOURS=24
TAWALA_JWT_ISSUER=http://localhost:8000
TAWALA_JWT_AUDIENCE=tawala-api
TAWALA_JWT_TTL_SEC=28800
TAWALA_EXCHANGE_REQUIRE_SUBSCRIPTION=false

# --- Optional later (N2+) ---
# REDIS_URL=redis://localhost:6379/0
