# NetHubKe API — copy to .env or .env.local (never commit real secrets)
# Pydantic settings load .env / .env.local from the backend working directory.

# --- App ---
APP_NAME=NetHubKe
APP_VERSION=0.1.0
IMAGE_TAG=local
STARTUP_TEST=false
ENVIRONMENT=development

# --- Postgres (required) ---
FASTAPI_DB_USER=nethub
FASTAPI_DB_PASSWORD=change-me
FASTAPI_DB_NAME=nethub_dev
FASTAPI_DB_HOST=localhost
FASTAPI_DB_PORT=5432

# --- OIDC IdP (resource-server validation of access tokens) ---
# Prefer OIDC_*; KEYCLOAK_* remain aliases for older deploys.
# Issuer must match token "iss" (no trailing slash).
OIDC_ISSUER=https://auth.nethub.co.ke
# JWKS URL — Zitadel default:
OIDC_JWKS_URL=https://auth.nethub.co.ke/oauth/v2/keys
# Audience must match token "aud" (Zitadel API / project audience).
# Create or configure this in Zitadel; override if your tokens use another aud.
AUDIENCE=nethub-api
JWKS_CACHE_TTL=3600
# Algorithms default RS256 in code
# ALGORITHMS=["RS256"]

# Deprecated aliases (still read if OIDC_* unset):
# KEYCLOAK_ISSUER_URL=https://auth.nethub.co.ke
# KEYCLOAK_JWKS=https://auth.nethub.co.ke/oauth/v2/keys

# CORS — comma-separated origins (no *)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Redis (N2+) — JWKS / signing-key metadata cache ---
REDIS_URL=redis://localhost:6379/0
JWKS_REDIS_TTL_SEC=120

# --- Tawala / product hard-session exchange (default OFF) ---
# Enable only after keys are managed (DB signing keys preferred).
TAWALA_EXCHANGE_ENABLED=false
# PKCS#8 PEM; avoid in production — set TAWALA_JWT_ALLOW_ENV_PEM only for local experiments
TAWALA_JWT_PRIVATE_KEY=
TAWALA_JWT_ALLOW_ENV_PEM=false
SIGNING_KEY_MAX_AGE_HOURS=168
SIGNING_KEY_RETIRE_OVERLAP_HOURS=24
TAWALA_JWT_ISSUER=http://localhost:8000
TAWALA_JWT_AUDIENCE=tawala-api
TAWALA_JWT_TTL_SEC=28800
TAWALA_EXCHANGE_REQUIRE_SUBSCRIPTION=false
