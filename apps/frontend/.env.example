# --- Site / Auth.js ---
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# AUTH_URL=

# --- OIDC IdP (prefer these; KEYCLOAK_* still work as aliases) ---
OIDC_CLIENT_ID=nethub-frontend
OIDC_CLIENT_SECRET=
# Issuer, e.g. https://auth.nethub.co.ke
OIDC_ISSUER=https://auth.nethub.co.ke

# Deprecated aliases (still read if OIDC_* unset)
# KEYCLOAK_CLIENT_ID=
# KEYCLOAK_CLIENT_SECRET=
# KEYCLOAK_ISSUER=
