# Auth.js
AUTH_SECRET=generate-a-long-random-string
AUTH_URL=http://localhost:3000

# IdP-agnostic OIDC (same provider the backend trusts)
AUTH_OIDC_ISSUER=https://auth.example.com
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
# Optional: override discovery; default is {issuer}/.well-known/openid-configuration
# AUTH_OIDC_WELL_KNOWN=

# NetHubKe resource server (Architecture A)
NETHUB_API_URL=http://localhost:8000
