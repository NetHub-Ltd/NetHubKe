# NetHubKe frontend (Next.js) — copy to .env.local (never commit secrets)

# --- Site / Auth.js ---
# Public URL of this app (callback base)
NEXTAUTH_URL=http://localhost:3000
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-long-random-string

# --- Keycloak OIDC (browser login) ---
KEYCLOAK_CLIENT_ID=nethub-frontend
KEYCLOAK_CLIENT_SECRET=
# Realm issuer, e.g. https://idp.example.com/realms/nethub
KEYCLOAK_ISSUER=https://idp.example.com/realms/nethub

# --- NetHubKe API ---
# Server-side URL used by Route Handlers / backendFetch (no trailing slash)
BACKEND_URL=http://localhost:8000
# Browser-visible API base if used by client code
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Optional: M-Pesa / Daraja (only if those demo routes are used) ---
# DARAJA_CONSUMER_KEY=
# DARAJA_CONSUMER_SECRET=
# DARAJA_PASSKEY=
# DARAJA_SHORTCODE=

# NODE_ENV is set by Next automatically (development | production)

# --- N7 Launch hop (SSO into product) — default OFF ---
# NEXT_PUBLIC_LAUNCH_HOP_ENABLED=true
# Hard-session entry URL for Tawala (token appended as URL hash)
# NEXT_PUBLIC_TAWALA_LAUNCH_URL=https://app.tawala.example/auth/hard-session
# Prefer NEXT_PUBLIC_BACKEND_URL for browser exchange calls
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
