# NetHubKe frontend (Next.js) — copy to .env.local (never commit secrets)

# --- Site / Auth.js ---
# Public URL of this app (OAuth callback base). Production: https://nethub.co.ke
NEXTAUTH_URL=http://localhost:3000
# AUTH_URL=   # optional alias some setups use
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-long-random-string
# Auth.js v5 also accepts AUTH_SECRET (same value is fine)
AUTH_SECRET=replace-with-long-random-string

# --- OIDC IdP (prefer these) ---
# Issuer must match token "iss" (no trailing slash).
# Zitadel example: https://auth.nethub.co.ke
OIDC_ISSUER=https://auth.nethub.co.ke
# Client from Zitadel app "nethub-frontend" (or your IdP app name)
OIDC_CLIENT_ID=nethub-frontend
OIDC_CLIENT_SECRET=
# Auth.js provider id is "oidc" → callback path:
#   {NEXTAUTH_URL}/api/auth/callback/oidc
# Register users at the IdP first; NetHub syncs on login via /users/sync.

# --- Deprecated aliases (still read if OIDC_* unset) ---
# KEYCLOAK_ISSUER=https://auth.nethub.co.ke
# KEYCLOAK_CLIENT_ID=nethub-frontend
# KEYCLOAK_CLIENT_SECRET=

# --- NetHubKe API ---
# Server-side URL used by Route Handlers / backendFetch (no trailing slash)
BACKEND_URL=http://localhost:8000
# Browser-visible API base if used by client code
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Optional: M-Pesa / Daraja (only if those demo routes are used) ---
# DARAJA_CONSUMER_KEY=
# DARAJA_CONSUMER_SECRET=
# DARAJA_PASSKEY=
# DARAJA_SHORTCODE=
