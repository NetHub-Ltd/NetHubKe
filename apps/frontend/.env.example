# Public corporate website
NEXT_PUBLIC_SITE_URL=https://nethub.co.ke
# Business enquiries
NEXT_PUBLIC_CONTACT_EMAIL=hello@nethub.co.ke

# Auth.js
AUTH_SECRET=generate-a-long-random-string
AUTH_URL=http://localhost:3000

# IdP-agnostic OIDC (same provider the backend trusts)
AUTH_OIDC_ISSUER=https://auth.example.com
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
# Optional: override discovery; default is {issuer}/.well-known/openid-configuration
# AUTH_OIDC_WELL_KNOWN=

# NetHubKe resource server (Architecture A)
NETHUB_API_URL=http://localhost:8000

# Must match the public site URL exactly (scheme + host, no trailing slash issues)
# AUTH_URL=https://nethub.co.ke
# Stable secret across deploys — rotating AUTH_SECRET invalidates PKCE cookies mid-login
# AUTH_SECRET=
# Optional force secure cookies (default: on when AUTH_URL is https or on Vercel)
# AUTH_USE_SECURE_COOKIES=true
# AUTH_DEBUG=true
