# NetHubKe frontend (Next.js) — copy to .env.local (never commit secrets)

# --- Site / Auth.js ---
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-long-random-string

# --- Upstream OIDC provider ---
# Configure the issuer and client registered with whichever OIDC provider is used.
# Auth.js discovers authorization, token, JWKS and logout endpoints from this issuer.
OIDC_ISSUER=https://identity.example.com
OIDC_CLIENT_ID=nethub-frontend
OIDC_CLIENT_SECRET=
# Auth.js provider id is "oidc" → callback path:
#   {NEXTAUTH_URL}/api/auth/callback/oidc
# Account initialization is performed server-side through NetHubKe /users/sync.

# --- NetHubKe API ---
# Server-only URL used by Route Handlers / backendFetch (no trailing slash).
# Browser code must call same-origin BFF routes; do not expose the API origin.
BACKEND_URL=http://localhost:8000

# Product launch is intentionally disabled until one-time server-to-server
# launch-code redemption exists. Do not add product JWTs to browser redirects.

# --- Optional: M-Pesa / Daraja (only if those demo routes are used) ---
# DARAJA_CONSUMER_KEY=
# DARAJA_CONSUMER_SECRET=
# DARAJA_PASSKEY=
# DARAJA_SHORTCODE=
